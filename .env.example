# ── ИИ: anthropic (по умолчанию) или openai (любой OpenAI-совместимый) ──
AI_PROVIDER=anthropic
AI_LOG_COST=1

# вариант 1 — Anthropic
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-haiku-4-5

# вариант 2 — бесплатно для теста, Gemini (данные free tier идут на обучение Google!)
# AI_PROVIDER=openai
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=
# AI_MODEL=gemini-2.5-flash

# ── Доступ в админку (в базе персональные данные клиентов) ──
ADMIN_USER=admin
ADMIN_PASS=

# ── Канал: baileys | meta | waha | mock ──
CHANNEL=baileys

# meta — официальный WhatsApp Cloud API
META_TOKEN=
META_PHONE_ID=
META_VERIFY_TOKEN=test-token

# waha — внешний шлюз в Docker (альтернатива встроенному baileys)
WAHA_URL=http://localhost:3001
WAHA_SESSION=default
WAHA_API_KEY=

# проверить бота одному, без второго телефона:
# бот будет отвечать в чате «Сообщение себе»
SELF_TEST=1

# ИИ автоотвечает только этим номерам (через запятую). Пусто — всем.
# Нужно, пока бот сидит на личном номере с реальными контактами.
ALLOWED_NUMBERS=

PORT=3000
